From 1b29f6c170a6138e799198b7629046ae570f836e Mon Sep 17 00:00:00 2001
From: Jeff Lin <jeffulin@google.com>
Date: Wed, 4 Nov 2026 02:19:21 +0000
Subject: [PATCH] Revert "[base] Make Feature default state private"

This reverts commit cc9e5939f0f76c5b26ed0b2ad82191304b3c1153
(crrev.com/1728394, crrev.com/c/8638439).

The upstream change made base::Feature::default_state private (renamed
to default_state_) so that callers must use the public
Feature::GetDefaultState() accessor instead.
chromeos-base/redaction_tool still reads base::Feature::default_state
directly and fails to build without this patch. Keep the member public
until redaction_tool is migrated to GetDefaultState() in
crrev.com/c/8682761.

BUG=b:581572552
TEST=sudo emerge libchrome

patch-name: backward-compatibility-2200-Revert-base-Make-Feature-default-state-private.patch
Change-Id: I4ea87a86119348da4e483be61aca240383bb75f6
---
 base/feature.h                | 10 ++++++----
 base/feature_list_unittest.cc |  2 +-
 2 files changed, 7 insertions(+), 5 deletions(-)

diff --git a/base/feature.h b/base/feature.h
index fa79f68024..2c79b55730 100644
--- a/base/feature.h
+++ b/base/feature.h
@@ -259,7 +259,11 @@ struct BASE_EXPORT LOGICALLY_CONST Feature {
   // Returns the default state (i.e. enabled or disabled) for this feature.
   // NOTE: The actual runtime state may be different, due to a field trial or a
   // command line switch.
-  FeatureState GetDefaultState() const { return default_state_; }
+  FeatureState GetDefaultState() const { return default_state; }
+
+  // TODO(crbug.com/564547797): Make private once internal callers migrate to
+  // GetDefaultState().
+  const FeatureState default_state;
 
  protected:
   // Base constructor that performs initialization and checks, with an option to
@@ -270,7 +274,7 @@ struct BASE_EXPORT LOGICALLY_CONST Feature {
                     internal::FeatureMacroHandshake handshake,
                     bool is_country_specific)
       : name(name),
-        default_state_(default_state),
+        default_state(default_state),
         cached_value(is_runtime_mutable ? kRuntimeMutabilityMask : 0) {
     if (is_country_specific != IsCountrySpecificFeatureState(default_state)) {
       LOG(FATAL) << "Pass a country-specific default state if and only if you "
@@ -292,8 +296,6 @@ struct BASE_EXPORT LOGICALLY_CONST Feature {
   // Keep this in sync with base/feature_list_internal.h:kRuntimeMutabilityMask
   enum { kRuntimeMutabilityMask = 1 << 18 };
 
-  const FeatureState default_state_;
-
   // A packed value where bits 24 and 25 hold the resolved enabled state and
   // whether the feature was explicitly overridden, bits 16 through 23 hold
   // flags (e.g. logging and runtime mutability), and the last 16 bits are a
diff --git a/base/feature_list_unittest.cc b/base/feature_list_unittest.cc
index 9212810a29..06ffa45b67 100644
--- a/base/feature_list_unittest.cc
+++ b/base/feature_list_unittest.cc
@@ -186,7 +186,7 @@ class FeatureListTest : public testing::Test {
   static_assert(sizeof(Feature) == (sizeof(void*) == 8 ? 16 : 12));
   static_assert(alignof(Feature) == alignof(void*));
   static_assert(offsetof(Feature, name) == 0);
-  static_assert(offsetof(Feature, default_state_) == sizeof(void*));
+  static_assert(offsetof(Feature, default_state) == sizeof(void*));
   static_assert(offsetof(Feature, cached_value) == sizeof(void*) + 4);
   // LINT.ThenChange(feature.rs:FeatureStruct)
 
-- 
